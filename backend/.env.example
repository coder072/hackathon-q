APP_NAME=QR Phishing Detector API
APP_VERSION=1.0.0
DEBUG=false

# 로컬 PostgreSQL (docker compose up db). 스키마는 alembic upgrade head 로 만든다
# docker compose 로 백엔드까지 띄우면 compose 파일의 값(db 호스트)이 이 값을 덮어쓴다
DATABASE_URL=postgresql+psycopg://qr:qr@localhost:5433/qr

# 콤마로 구분한 프론트엔드 Origin 목록
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# 분석 요청 제한(IP 기준), 분석 세션 보관 시간
ANALYSIS_RATE_LIMIT=30/minute
SESSION_RETENTION_HOURS=24

# 의도 분류 LLM (4~6점 분석의 POST /intent-guidance 에서만 호출). 키가 없으면 규칙 기반 분류기만 사용
ANTHROPIC_API_KEY=
INTENT_MODEL=claude-haiku-4-5
